{
	"version": 2,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"settings": {
		"appearanceTools": true,
		"custom": {
			"borderRadius": "8px",
			"formFieldBorderColor": "var(--wp--preset--color--grey, #DADCE0)",
			"formFieldBackground": "#ffffff"
		},
		"color": {
            "defaultGradients": false,
			"palette": [
				{
					"slug": "color1",
					"color": "#E1D7C6",
					"name": "Color 1 (Section backgrounds)"
				},
                {
                  "slug": "color2",
                  "color": "#2C2A29",
                  "name": "Color 2 (Section backgrounds)"
                },
                {
                  "slug": "color3",
                  "color": "#5A504A",
                  "name": "Color 3 (Button background)"
                },
                {
                  "slug": "light",
                  "color": "#ffffff",
                  "name": "Light (Text on Color 2 and Gradient)"
                },
                {
                  "slug": "dark",
                  "color": "#0d141a",
                  "name": "Dark (Text on Light and Color 1)"
                },
                {
                  "slug": "grey",
                  "color": "#B8C0CC",
                  "name": "Grey (Form borders)"
                },
                {
                  "slug": "page-background",
                  "color": "#ffffff",
                  "name": "Page background"
                },
                {
                  "slug": "page-text",
                  "color": "#000000",
                  "name": "Page text"
                },
                {
                  "slug": "button-text",
                  "color": "#ffffff",
                  "name": "Button text"
                }
			],
			"gradients": [
				{
					"slug": "gradient-one",
					"gradient": "linear-gradient(135deg, #E1D7C6 0%, #D4A373 100%)",
					"name": "Section background gradient"
				}
			]
		},
		"layout": {
			"contentSize": "700px",
			"wideSize": "1100px"
		},
		"spacing": {
            "blockGap": true,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingScale": { "steps": 0 },
			"spacingSizes": [
				{ "slug": "20", "size": "8px", "name": "1" },
				{ "slug": "30", "size": "8px", "name": "2" },
				{ "slug": "40", "size": "16px", "name": "3" },
				{ "slug": "50", "size": "24px", "name": "4" },
				{ "slug": "60", "size": "32px", "name": "5" },
				{ "slug": "70", "size": "48px", "name": "6" },
				{ "slug": "80", "size": "64px", "name": "7" }
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "slug": "sm", "name": "Small", "shadow": "0 1px 2px rgba(17, 17, 17, 0.06)" },
				{ "slug": "md", "name": "Medium", "shadow": "0 4px 10px rgba(17, 17, 17, 0.08)" },
				{ "slug": "lg", "name": "Large", "shadow": "0 12px 22px rgba(17, 17, 17, 0.1)" },
				{ "slug": "xl", "name": "Extra Large", "shadow": "0 18px 34px rgba(17, 17, 17, 0.12)" },
				{ "slug": "xxl", "name": "Huge", "shadow": "0 30px 55px rgba(17, 17, 17, 0.16)" }
			]
		},
 	"typography": {
 		"dropCap": false,
